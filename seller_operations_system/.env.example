# ===================================================================
# SELLER OPERATIONS & PAYOUT INTELLIGENCE PLATFORM - ENVIRONMENT CONFIG
# ===================================================================

# 1. Flask Core Settings
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Cryptographic Secret Key (Generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-key-in-production

# 2. Database Connectivity
# Option A: Full Connection String (Standard on Render, Railway, AWS RDS, Heroku)
# PostgreSQL format: postgresql://username:password@hostname:5432/database_name
# MySQL format: mysql+mysqlconnector://username:password@hostname:3306/database_name
# SQLite format (Local/Embedded): sqlite:///seller_ops_db.sqlite
DATABASE_URL=

# Option B: Discrete Parameters (Used if DATABASE_URL is not set)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=seller_ops_db

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# 3. Security & Session Settings
SESSION_COOKIE_SECURE=true

# 4. Production WSGI Server (Gunicorn) Settings
WORKERS=4
LOG_LEVEL=info
